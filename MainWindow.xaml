<Window x:Class="MailNotification.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MailNotification"
        Title="Mail Notification" Width="760" Height="620" MinWidth="560" MinHeight="460"
        Icon="Assets/app.ico" Background="#F6F7FB" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>
    <Grid Margin="20">
        <TabControl BorderThickness="0" Background="Transparent">
            <TabItem Header="{Binding [accounts], Source={x:Static l:Loc.I}}" FontSize="14">
                <DockPanel Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Style="{StaticResource Primary}" Click="Add_Click"
                                Content="{Binding [addAccount], Source={x:Static l:Loc.I}}"/>
                        <Button Click="Check_Click" Content="{Binding [checkNow], Source={x:Static l:Loc.I}}"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="#6B7280" TextAlignment="Center"
                               Margin="0,40" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="{Binding [noAccounts], Source={x:Static l:Loc.I}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E3E6EE" BorderThickness="1" CornerRadius="10"
                                            Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="26" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EEF1F8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                <Setter Property="Background" Value="#E53935"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Background" Value="#FDECEA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CountText}" FontSize="20" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Email}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Primary}" Click="Open_Click"
                                                        Content="{Binding [openGmail], Source={x:Static l:Loc.I}}"/>
                                                <Button Click="Edit_Click" Content="{Binding [edit], Source={x:Static l:Loc.I}}"/>
                                                <Button Click="Remove_Click" Foreground="#C62828" Margin="0"
                                                        Content="{Binding [remove], Source={x:Static l:Loc.I}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding [settings], Source={x:Static l:Loc.I}}">
                <StackPanel Margin="0,18,0,0">
                    <Grid Margin="0,0,0,14">
                        <TextBlock VerticalAlignment="Center" Text="{Binding [language], Source={x:Static l:Loc.I}}"/>
                        <ComboBox x:Name="LangBox" Width="180" HorizontalAlignment="Right" SelectionChanged="Lang_Changed">
                            <ComboBoxItem Tag="ca" Content="Català"/>
                            <ComboBoxItem Tag="es" Content="Castellano"/>
                            <ComboBoxItem Tag="en" Content="English"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock VerticalAlignment="Center" Text="{Binding [interval], Source={x:Static l:Loc.I}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="IntervalBox" Width="70" Padding="4" LostFocus="Interval_LostFocus"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding [minutes], Source={x:Static l:Loc.I}}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="AutostartBox" Margin="0,0,0,12" Click="Option_Click"
                              Content="{Binding [autostart], Source={x:Static l:Loc.I}}"/>
                    <CheckBox x:Name="StartMinBox" Margin="0,0,0,12" Click="Option_Click"
                              Content="{Binding [startMinimized], Source={x:Static l:Loc.I}}"/>
                    <CheckBox x:Name="TrayBox" Margin="0,0,0,12" Click="Option_Click"
                              Content="{Binding [minimizeToTray], Source={x:Static l:Loc.I}}"/>
                    <TextBlock FontWeight="SemiBold" Margin="0,14,0,6" Text="{Binding [oauthClient], Source={x:Static l:Loc.I}}"/>
                    <TextBlock Margin="0,0,0,2" Text="Client ID"/>
                    <TextBox x:Name="ClientIdBox" Padding="4" Margin="0,0,0,8" LostFocus="OAuth_LostFocus"/>
                    <TextBlock Margin="0,0,0,2" Text="Client secret"/>
                    <PasswordBox x:Name="ClientSecretBox" Padding="4" Margin="0,0,0,6" LostFocus="OAuth_LostFocus"/>
                    <TextBlock Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [oauthClientHelp], Source={x:Static l:Loc.I}}"/>
                    <TextBlock Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="{Binding [imapHelp], Source={x:Static l:Loc.I}}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
