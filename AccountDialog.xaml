<Window x:Class="MailNotification.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MailNotification"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Icon="Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock Text="{Binding [email], Source={x:Static l:Loc.I}}" Margin="0,0,0,4"/>
        <TextBox x:Name="EmailBox" Padding="6" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding [authMethod], Source={x:Static l:Loc.I}}" Margin="0,0,0,4"/>
        <ComboBox x:Name="MethodBox" Padding="6" Margin="0,0,0,12" SelectionChanged="Method_Changed">
            <ComboBoxItem Tag="password" Content="{Binding [methodPassword], Source={x:Static l:Loc.I}}"/>
            <ComboBoxItem Tag="oauth" Content="{Binding [methodOAuth], Source={x:Static l:Loc.I}}"/>
        </ComboBox>
        <StackPanel x:Name="PassPanel">
            <TextBlock Text="{Binding [appPassword], Source={x:Static l:Loc.I}}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PassBox" Padding="6" Margin="0,0,0,4"/>
            <TextBlock Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="{Binding [appPasswordHelp], Source={x:Static l:Loc.I}}"/>
        </StackPanel>
        <TextBlock x:Name="OAuthHelp" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="Collapsed" Text="{Binding [oauthHelp], Source={x:Static l:Loc.I}}"/>
        <TextBlock Text="{Binding [notifyType], Source={x:Static l:Loc.I}}" Margin="0,0,0,4"/>
        <ComboBox x:Name="NotifyBox" Padding="6" Margin="0,0,0,12">
            <ComboBoxItem Tag="none" Content="{Binding [notifyNone], Source={x:Static l:Loc.I}}"/>
            <ComboBoxItem Tag="badge" Content="{Binding [notifyBadge], Source={x:Static l:Loc.I}}"/>
            <ComboBoxItem Tag="toast" Content="{Binding [notifyToast], Source={x:Static l:Loc.I}}"/>
        </ComboBox>
        <TextBlock x:Name="ErrorText" Foreground="#C62828" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button IsCancel="True" Content="{Binding [cancel], Source={x:Static l:Loc.I}}"/>
            <Button x:Name="SaveBtn" Style="{StaticResource Primary}" IsDefault="True" Margin="0" Click="Save_Click"
                    Content="{Binding [save], Source={x:Static l:Loc.I}}"/>
        </StackPanel>
    </StackPanel>
</Window>
